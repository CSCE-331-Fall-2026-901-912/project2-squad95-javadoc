<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.ManagerCtrl">
    
    <!-- Navigation Sidebar -->
    <left>
        <VBox spacing="10" prefWidth="200" styleClass="sidebar">
            <Button text="Dashboard" onAction="#showDashboard" prefWidth="200" styleClass="nav-btn active-nav-btn"/>
            <Button text="Financials" onAction="#showFinancials" prefWidth="200" styleClass="nav-btn"/>
            <Button text="Menu" onAction="#showMenu" prefWidth="200" styleClass="nav-btn"/>
            <Button text="Orders" onAction="#showOrders" prefWidth="200" styleClass="nav-btn"/>
            <Button text="Employees" onAction="#showEmployees" prefWidth="200" styleClass="nav-btn"/>
            <Button text="Inventory" onAction="#showInventory" prefWidth="200" styleClass="nav-btn"/>
            <Button text="Settings" prefWidth="200" styleClass="nav-btn"/>
            <Button text="Cashier" onAction="#switchToCashier" prefWidth="200" styleClass="nav-btn"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: white;">
            <StackPane style="-fx-padding: 20;">
                
                <!-- Dashboard -->
                <VBox fx:id="dashboardView" spacing="20">
                    <HBox spacing="20">
                        <VBox styleClass="kpi-card kpi-green" alignment="CENTER" prefWidth="250" prefHeight="100">
                            <Label text="Revenue" style="-fx-font-size: 18px;"/>
                            <Label fx:id="revenueTotalLabel" text="\$24,680" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                            <Label text="+12%" style="-fx-font-size: 16px;"/>
                        </VBox>
                        <VBox styleClass="kpi-card kpi-red" alignment="CENTER" prefWidth="250" prefHeight="100">
                            <Label text="Orders today" style="-fx-font-size: 18px;"/>
                            <Label fx:id="ordersTotalLabel" text="42" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                            <Label text="-8%" style="-fx-font-size: 16px;"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="20" VBox.vgrow="ALWAYS">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Revenue trend" alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 18px;"/>
                            <BarChart fx:id="revenueTrendChart" prefHeight="250" VBox.vgrow="ALWAYS">
                                <xAxis><CategoryAxis/></xAxis>
                                <yAxis><NumberAxis/></yAxis>
                            </BarChart>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Top cashiers" alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 18px;"/>
                            <BarChart fx:id="topCashiersChart" prefHeight="250" VBox.vgrow="ALWAYS">
                                <xAxis><NumberAxis/></xAxis>
                                <yAxis><CategoryAxis/></yAxis>
                            </BarChart>
                        </VBox>
                    </HBox>
                    <HBox spacing="20" VBox.vgrow="ALWAYS">
                        <TableView fx:id="inventoryTable" prefHeight="250" HBox.hgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="inventoryIdColumn" text="ID" prefWidth="70"/>
                                <TableColumn fx:id="inventoryNameColumn" text="Item" prefWidth="200"/>
                                <TableColumn fx:id="inventoryUnitColumn" text="Unit" prefWidth="120"/>
                                <TableColumn fx:id="inventoryQuantityColumn" text="Quantity" prefWidth="150"/>
                            </columns>
                        </TableView>
                        <TableView fx:id="employeeTable" prefHeight="250" HBox.hgrow="ALWAYS">
                            <columns>
                                <TableColumn text="Cashier" prefWidth="100"/>
                                <TableColumn text="Hours worked" prefWidth="100"/>
                                <TableColumn text="Sales made" prefWidth="100"/>
                                <TableColumn text="Manager" prefWidth="90"/>
                            </columns>
                        </TableView>
                    </HBox>
                    
                </VBox>

                <!-- Financials -->
                <HBox fx:id="financialsView" spacing="30" visible="false" managed="false">
                    <VBox spacing="20" prefWidth="400">
                        <HBox spacing="20">
                            <VBox styleClass="kpi-card kpi-green" alignment="CENTER" prefWidth="190" prefHeight="100">
                                <Label text="Revenue" style="-fx-font-size: 18px;"/>
                                <Label fx:id="finRevenueTotalLabel" text="\$24,680" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                                <Label text="+12%" style="-fx-font-size: 16px;"/>
                            </VBox>
                            <VBox styleClass="kpi-card kpi-red" alignment="CENTER" prefWidth="190" prefHeight="100">
                                <Label text="Sales Goal" style="-fx-font-size: 18px;"/>
                                <Label fx:id="finOrdersTotalLabel" text="\$26,000" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                                <Label text="-8%" style="-fx-font-size: 16px;"/>
                            </VBox>
                        </HBox>
                        <Label text="Revenue trend" alignment="CENTER" prefWidth="400" style="-fx-font-size: 18px;"/>
                        <BarChart fx:id="finRevenueTrendChart" prefHeight="350">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis/></yAxis>
                        </BarChart>
                    </VBox>
                    <VBox spacing="10" alignment="BOTTOM_RIGHT" prefWidth="400" HBox.hgrow="ALWAYS">
                        <TableView fx:id="financialsTable" prefHeight="450" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="finDayCol" text="Day" prefWidth="80"/>
                                <TableColumn fx:id="finTotalOrdersCol" text="total order" prefWidth="100"/>
                                <TableColumn fx:id="finAmountCol" text="amount" prefWidth="100"/>
                                <TableColumn fx:id="finMetGoalCol" text="meets goal" prefWidth="100"/>
                            </columns>
                        </TableView>
                        <Button fx:id="printReportButton" text="Print" style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #333; -fx-background-color: white; -fx-padding: 5 25; -fx-font-size: 14px;"/>
                    </VBox>
                </HBox>

                
                <!-- Menu Management -->
                <VBox fx:id="menuView" spacing="20" visible="false" managed="false">
                    <Label text="Menu Management" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    <TableView fx:id="menuTable" VBox.vgrow="ALWAYS" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="menuIdColumn" text="ID" prefWidth="80"/>
                            <TableColumn fx:id="menuNameColumn" text="Menu Item" prefWidth="250"/>
                            <TableColumn fx:id="menuPriceColumn" text="Price ($)" prefWidth="150"/>
                        </columns>
                    </TableView>
                    <HBox spacing="20">
                        <Button text="Add Item" onAction="#addMenuItem"/>
                        <Button text="Update Item" onAction="#updateMenuItem"/>
                    </HBox>
                </VBox>

                <!-- Orders -->
                <VBox fx:id="ordersView" spacing="20" visible="false" managed="false">
                    <HBox spacing="30">
                        <VBox styleClass="kpi-card kpi-red" alignment="CENTER" prefWidth="220" prefHeight="120">
                            <Label text="Orders today" style="-fx-font-size: 18px;"/>
                            <Label text="42" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                            <Label text="-8%" style="-fx-font-size: 16px;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Order trend" alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 18px;"/>
                            <BarChart fx:id="orderTrendChart" prefHeight="150">
                                <xAxis><CategoryAxis/></xAxis>
                                <yAxis><NumberAxis/></yAxis>
                            </BarChart>
                        </VBox>
                    </HBox>
                    
                    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Order #" prefWidth="100"/>
                            <TableColumn text="Items" prefWidth="300"/>
                            <TableColumn text="total" prefWidth="100"/>
                            <TableColumn text="date" prefWidth="150"/>
                            <TableColumn text="time" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Employees -->
                <VBox fx:id="employeesView" spacing="20" visible="false" managed="false">
                    <HBox spacing="30">
                        <VBox styleClass="kpi-card kpi-green" alignment="CENTER" prefWidth="220" prefHeight="120">
                            <Label text="Total Man Hours" style="-fx-font-size: 18px;"/>
                            <Label text="###" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Top cashiers" alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 18px;"/>
                            <BarChart fx:id="empTopCashiersChart" prefHeight="150">
                                <xAxis><NumberAxis/></xAxis>
                                <yAxis><CategoryAxis/></yAxis>
                            </BarChart>
                        </VBox>
                    </HBox>
                    
                    <TableView fx:id="employeesFullTable" VBox.vgrow="ALWAYS" prefHeight="300">
                        <columns>
                            <TableColumn fx:id="cashierColumn" text="Cashier" prefWidth="150"/>
                            <TableColumn fx:id="hoursColumn" text="Hours worked" prefWidth="150"/>
                            <TableColumn fx:id="salesColumn" text="Sales made" prefWidth="150"/>
                            <TableColumn fx:id="managerColumn" text="Manager" prefWidth="100"/>
                        </columns>
                    </TableView>

                    <HBox spacing="20">
                        <Button text="Add User" onAction="#addEmployee"/>

                        <Button text="Update User" onAction="#updateEmployee"/>

                        <Button text="Remove User" onAction="#removeEmployee"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Promote To Manager" onAction="#promoteEmployee"/>
                    </HBox>
                </VBox>

                <!-- Inventory -->
                <VBox fx:id="inventoryFullView" spacing="20" visible="false" managed="false">
                    <HBox spacing="30">
                        <Button text="Add Item"  onAction="#addInventoryItem"/>
                        <Button text="Update Quantity" onAction="#updateInventoryQuantity"/>
                        <VBox styleClass="kpi-card kpi-red" alignment="CENTER" prefWidth="220" prefHeight="120">
                            <Label text="Low Stock" style="-fx-font-size: 18px;"/>
                            <Label text="##" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                            <Label text="Order Soon!" style="-fx-font-size: 16px;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Stock Totals" alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 18px;"/>
                            <BarChart fx:id="inventoryStockChart" prefHeight="150">
                                <xAxis><CategoryAxis/></xAxis>
                                <yAxis><NumberAxis/></yAxis>
                            </BarChart>
                        </VBox>
                    </HBox>
                    
                    <TableView fx:id="inventoryFullTable" VBox.vgrow="ALWAYS" prefHeight="300">
                        <columns>
                            <TableColumn fx:id="inventoryIdColumn" text="ID" prefWidth="70"/>
                            <TableColumn fx:id="inventoryNameColumn" text="Inventory" prefWidth="200"/>
                            <TableColumn fx:id="inventoryQuantityColumn" text="On Hand" prefWidth="150"/>
                            <TableColumn fx:id="inventoryUnitColumn" text="Unit" prefWidth="120"/>
                        </columns>
                    </TableView>

                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <Button text="Add Item" onAction="#addInventoryItem"/>
                        <Button text="Update Quantity" onAction="#updateInventoryQuantity"/>
                    </HBox>
                </VBox>

            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>