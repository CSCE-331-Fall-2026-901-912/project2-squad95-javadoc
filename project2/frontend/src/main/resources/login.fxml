<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.LoginCtrl">
    <Label text="Employee Login" style="-fx-font-size: 20px;"/>
    <TextField fx:id="employeeIdField" maxWidth="150" promptText="Employee ID"/>
    <Button text="Login" onAction="#handleLogin"/>
    <Label fx:id="errorLabel" textFill="RED"/>
</VBox>